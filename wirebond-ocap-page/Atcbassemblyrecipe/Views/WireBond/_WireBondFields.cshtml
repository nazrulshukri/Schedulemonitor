@model WireBondPanelModel

@*
    The 25 writable TBLWIREBOND fields. Rendered once for the add panel and once
    per row for the edit panels, so the two can never fall out of step.

    Every input reaches its form through form="@Model.FormId" - the forms
    themselves live outside the table (see the note in _AwacsForm.cshtml and
    excel-grid.js: a <form> written between two <tr> elements is closed by the
    HTML parser and its hidden inputs are moved out of it).

    data-original-value is what excel-grid.js reads to put a cancelled edit back;
    the page's own script extends that to the textareas.

    WBOCAPWWK has no input: the database trigger derives it from the OCAP date.
*@

@{
    var row = Model.Row;
}

<div class="wirebond-panel">
    <div class="row g-2">
        <div class="col-12">
            <span class="eyebrow">@(Model.IsEdit ? "Edit OCAP record" : "New OCAP record")</span>
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-OcapNo">OCAP No <span class="text-danger">*</span></label>
            <input id="@(Model.FormId)-OcapNo" name="OcapNo" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="OCAP-WB-2026-001" required
                   value="@row?.OcapNo" data-original-value="@row?.OcapNo" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-OcapDate">OCAP Date <span class="text-danger">*</span></label>
            <input id="@(Model.FormId)-OcapDate" name="OcapDate" form="@Model.FormId" type="datetime-local"
                   class="form-control cell-input" required
                   value="@(row?.OcapDate?.ToString("yyyy-MM-ddTHH:mm"))"
                   data-original-value="@(row?.OcapDate?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Work Week</label>
            <input class="form-control cell-input bg-light text-muted" readonly aria-readonly="true"
                   value="@(Model.IsEdit ? row?.OcapWorkWeek : "Set by the database")"
                   title="WBOCAPWWK is calculated by the OCAP_WIREBOND_WORKWEEK trigger from the OCAP date" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-Bfg">BFG</label>
            <input id="@(Model.FormId)-Bfg" name="Bfg" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="BFG1"
                   value="@row?.Bfg" data-original-value="@row?.Bfg" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-IssuedBy">Issued By</label>
            <input id="@(Model.FormId)-IssuedBy" name="IssuedBy" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="NX487878"
                   value="@row?.IssuedBy" data-original-value="@row?.IssuedBy" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-OperatorId">Operator ID</label>
            <input id="@(Model.FormId)-OperatorId" name="OperatorId" form="@Model.FormId" class="form-control cell-input"
                   maxlength="50" placeholder="OP1023"
                   value="@row?.OperatorId" data-original-value="@row?.OperatorId" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-Process">Process</label>
            <input id="@(Model.FormId)-Process" name="Process" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" list="wireBondProcessOptions" placeholder="WIREBOND"
                   value="@(Model.IsEdit ? row?.Process : "WIREBOND")" data-original-value="@row?.Process" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-Machine">Machine</label>
            <input id="@(Model.FormId)-Machine" name="Machine" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="WB-07"
                   value="@row?.Machine" data-original-value="@row?.Machine" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-Package">Package</label>
            <input id="@(Model.FormId)-Package" name="Package" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="SOT669"
                   value="@row?.Package" data-original-value="@row?.Package" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-SoQty">SO Qty</label>
            <input id="@(Model.FormId)-SoQty" name="SoQty" form="@Model.FormId" type="number" step="1" min="0"
                   class="form-control cell-input" placeholder="3000"
                   value="@row?.SoQty" data-original-value="@(row?.SoQty?.ToString())" />
        </div>

        <div class="col-12"><hr class="my-1" /></div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-Defect">Defect</label>
            <input id="@(Model.FormId)-Defect" name="Defect" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" list="wireBondDefectOptions" placeholder="NON STICK ON PAD"
                   value="@row?.Defect" data-original-value="@row?.Defect" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-DefectCategory">Defect Category</label>
            <input id="@(Model.FormId)-DefectCategory" name="DefectCategory" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" list="wireBondCategoryOptions" placeholder="PROCESS"
                   value="@row?.DefectCategory" data-original-value="@row?.DefectCategory" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="@(Model.FormId)-DefectOthers">Defect (Others)</label>
            <input id="@(Model.FormId)-DefectOthers" name="DefectOthers" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="Only when Defect is OTHERS"
                   value="@row?.DefectOthers" data-original-value="@row?.DefectOthers" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-MachineError">Machine Error</label>
            <input id="@(Model.FormId)-MachineError" name="MachineError" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="E-042"
                   value="@row?.MachineError" data-original-value="@row?.MachineError" />
        </div>

        <div class="col-md-9">
            <label class="form-label" for="@(Model.FormId)-RcMachineError">Machine Error - Root Cause</label>
            <input id="@(Model.FormId)-RcMachineError" name="RcMachineError" form="@Model.FormId" class="form-control cell-input"
                   maxlength="1000" placeholder="E-042 Z-axis search level fault"
                   value="@row?.RcMachineError" data-original-value="@row?.RcMachineError" />
        </div>

        <div class="col-12"><hr class="my-1" /></div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-Diff4M1E">4M1E</label>
            <input id="@(Model.FormId)-Diff4M1E" name="Diff4M1E" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" list="wireBondDifferenceOptions" placeholder="MACHINE"
                   value="@row?.Diff4M1E" data-original-value="@row?.Diff4M1E" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-DiffNo">Difference No</label>
            <input id="@(Model.FormId)-DiffNo" name="DiffNo" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="DIFF-2026-0912"
                   value="@row?.DiffNo" data-original-value="@row?.DiffNo" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-DiffFabSite">Fab Site</label>
            <input id="@(Model.FormId)-DiffFabSite" name="DiffFabSite" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="ATCB"
                   value="@row?.DiffFabSite" data-original-value="@row?.DiffFabSite" />
        </div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-DiffRejectQty">Reject Qty</label>
            <input id="@(Model.FormId)-DiffRejectQty" name="DiffRejectQty" form="@Model.FormId" type="number" step="1" min="0"
                   class="form-control cell-input" placeholder="120"
                   value="@row?.DiffRejectQty" data-original-value="@(row?.DiffRejectQty?.ToString())" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="@(Model.FormId)-DiffAffected">Affected</label>
            <input id="@(Model.FormId)-DiffAffected" name="DiffAffected" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="LOT2609001,LOT2609002"
                   value="@row?.DiffAffected" data-original-value="@row?.DiffAffected" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="@(Model.FormId)-DiffNotAffected">Not Affected</label>
            <input id="@(Model.FormId)-DiffNotAffected" name="DiffNotAffected" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="LOT2609003"
                   value="@row?.DiffNotAffected" data-original-value="@row?.DiffNotAffected" />
        </div>

        <div class="col-12">
            <label class="form-label" for="@(Model.FormId)-DiffRemarks">Difference Remarks</label>
            <textarea id="@(Model.FormId)-DiffRemarks" name="DiffRemarks" form="@Model.FormId" class="form-control"
                      rows="2" maxlength="2000" placeholder="What the difference was and how it was found"
                      data-original-value="@row?.DiffRemarks">@row?.DiffRemarks</textarea>
        </div>

        <div class="col-12"><hr class="my-1" /></div>

        <div class="col-md-3">
            <label class="form-label" for="@(Model.FormId)-VerifiedBy">Verified By</label>
            <input id="@(Model.FormId)-VerifiedBy" name="VerifiedBy" form="@Model.FormId" class="form-control cell-input"
                   maxlength="100" placeholder="NX000123"
                   value="@row?.VerifiedBy" data-original-value="@row?.VerifiedBy" />
        </div>

        <div class="col-md-9">
            <label class="form-label" for="@(Model.FormId)-Remarks">Remarks</label>
            <input id="@(Model.FormId)-Remarks" name="Remarks" form="@Model.FormId" class="form-control cell-input"
                   maxlength="500" placeholder="Raised on night shift"
                   value="@row?.Remarks" data-original-value="@row?.Remarks" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="@(Model.FormId)-ActionTaken">Action Taken</label>
            <textarea id="@(Model.FormId)-ActionTaken" name="ActionTaken" form="@Model.FormId" class="form-control"
                      rows="2" maxlength="2000" placeholder="Capillary replaced, machine requalified"
                      data-original-value="@row?.ActionTaken">@row?.ActionTaken</textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label" for="@(Model.FormId)-Disposition">Disposition</label>
            <textarea id="@(Model.FormId)-Disposition" name="Disposition" form="@Model.FormId" class="form-control"
                      rows="2" maxlength="2000" placeholder="Affected lots to 100% visual inspection"
                      data-original-value="@row?.Disposition">@row?.Disposition</textarea>
        </div>
    </div>
</div>
