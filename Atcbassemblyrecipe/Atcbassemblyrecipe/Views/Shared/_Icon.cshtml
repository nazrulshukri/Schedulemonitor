    the light and dark themes. Keep the names lowercase and hyphen-free.
*@
@{
    var body = Model switch
    {
        "search" => "<circle cx='11' cy='11' r='6'/><path d='m20 20-3.6-3.6'/>",
        "clear" => "<path d='M18 6 6 18M6 6l12 12'/>",
        "template" => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5'/><path d='M9 13h6M9 17h4'/>",
        "export" => "<path d='M12 3v12'/><path d='m8 11 4 4 4-4'/><path d='M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2'/>",
        "import" => "<path d='M12 15V3'/><path d='m8 7 4-4 4 4'/><path d='M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2'/>",
        "upload" => "<path d='M12 16V4'/><path d='m7 9 5-5 5 5'/><rect x='3' y='16' width='18' height='5' rx='2'/>",
        "download" => "<path d='M12 4v12'/><path d='m7 11 5 5 5-5'/><rect x='3' y='16' width='18' height='5' rx='2'/>",
        "font-down" => "<path d='M4 20 10 5l6 15'/><path d='M6.5 15h7'/><path d='M17 12h5'/>",
