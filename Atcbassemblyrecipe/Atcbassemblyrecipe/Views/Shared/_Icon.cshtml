        "back" => "<path d='M20 12H4'/><path d='m10 6-6 6 6 6'/>",
        "login" => "<path d='M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4'/><path d='M15 12H9'/><path d='m19 12-4-4v8z'/>",
