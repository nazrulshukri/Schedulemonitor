@model AwacsLfViewModel

@{
    ViewData["Title"] = "AWACSLF";
    var permission = await Access.GetAsync(ModuleNames.AwacsLf);
    var canAdd = permission.CanAdd;
    var canUpdate = permission.CanUpdate;
    var canDelete = permission.CanDelete;

    // Package -> LFSIZE, handed to the add-row script below.
    var knownLfSizesJson = System.Text.Json.JsonSerializer.Serialize(
        LeadframeSizes.Known.ToDictionary(entry => entry.Package, entry => entry.LfSize));
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Recipe Workspace</span>
        <h1>AWACSLF</h1>
        <p>Leadframe master: LF 12NC, LFSIZE, default WO quantity, package and device.</p>
    </div>
    @if (canAdd)
    {
        <button type="button" class="btn btn-primary" id="showAddRow"><partial name="_Icon" model="@("plus")" /> Add Leadframe</button>
    }
</div>

<section class="data-panel excel-toolbar-panel">
    <form asp-controller="AwacsLf" asp-action="Index" method="get" class="excel-search">
        <input type="hidden" name="sortBy" value="@Model.SortBy" />
        <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
        <div>
            <label for="search" class="form-label">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search LF 12NC, LFSIZE, package, or device" />
        </div>
        <div>
            <label for="pageSize" class="form-label">Rows</label>
            <select id="pageSize" name="pageSize" class="form-select">
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary"><partial name="_Icon" model="@("search")" /> Search</button>
        <a asp-controller="AwacsLf" asp-action="Index" class="btn btn-outline-secondary"><partial name="_Icon" model="@("clear")" /> Clear</a>
    </form>

    <div class="excel-actions">
        <button type="button" class="btn btn-outline-secondary" data-template-modal><partial name="_Icon" model="@("template")" /> Template</button>
        <a class="btn btn-outline-secondary" asp-controller="AwacsLf" asp-action="Export" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection"><partial name="_Icon" model="@("export")" /> Export CSV</a>
        @if (canAdd)
        {
            <form asp-controller="AwacsLf" asp-action="Import" method="post" enctype="multipart/form-data" class="csv-import-form">
                <label class="btn btn-outline-secondary mb-0" for="awacsLfCsvFile"><partial name="_Icon" model="@("import")" /> Import CSV</label>
                <input id="awacsLfCsvFile" name="csvFile" type="file" accept=".csv,.txt,.tsv" />
                <button type="submit" class="btn btn-primary"><partial name="_Icon" model="@("upload")" /> Upload</button>
                <span class="csv-file-error" data-csv-file-error aria-live="polite"></span>
            </form>
        }
    </div>
</section>



<datalist id="lfSizeOptions">
    @foreach (var (package, lfSize) in LeadframeSizes.Known)
    {
        <option value="@lfSize" label="@package"></option>
    }
</datalist>

<div class="table-responsive data-panel excel-panel">
    <table class="table table-hover align-middle excel-table" id="awacsLfTable" data-resizable-table="awacslf">
        <colgroup>
            <col class="col-select" />
            <col class="col-sequence" />
            <col class="col-leadframe" />
            <col class="col-wstype" />
            <col class="col-product" />
            <col class="col-package" />
            <col class="col-recipe" />
            <col class="col-user" />
            <col class="col-date" />
            <col class="col-action" />
            <col class="col-action" />
        </colgroup>
        <thead>
            <tr>
                <th data-col-key="select"><input class="form-check-input" type="checkbox" aria-label="Select all rows" disabled /><span class="column-resizer"></span></th>
                @foreach (var column in SortableColumns)
                {
                    <th data-col-key="@column.Key">
                        <a class="sort-header @SortClass(Model, column.Key)" asp-controller="AwacsLf" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="@column.Key" asp-route-sortDirection="@NextSortDirection(Model, column.Key)">@column.Label<span></span></a>
                        <span class="column-resizer"></span>
                    </th>
                }
                <th data-col-key="edit">Edit<span class="column-resizer"></span></th>
                <th data-col-key="delete">Delete<span class="column-resizer"></span></th>
            </tr>
        </thead>
        <tbody>
            @if (canAdd)
            {
                <tr id="addRow" class="excel-edit-row @(Model.PromptAdd ? "" : "d-none")">
                    <td><input class="form-check-input" type="checkbox" aria-label="New row" disabled /></td>
                    <td><span class="cell-muted">New</span></td>
                    <td>
                        <input name="Lf12Nc" form="createAwacsLfForm" class="form-control cell-input" maxlength="16" placeholder="934661404115" required aria-label="LF 12NC" />
                    </td>
                    <td>
                        <input name="LfSize" form="createAwacsLfForm" class="form-control cell-input" maxlength="16" placeholder="20,5" list="lfSizeOptions"
                               pattern="\d{1,4}\s*,\s*\d{1,4}" title="Two numbers separated by a comma, for example 20,5" required data-lfsize aria-label="LFSIZE" />
                    </td>
                    <td>
                        <input name="DefaultWoQty"
                               form="createAwacsLfForm"
                               type="number"
                               step="1"
                               min="0"
                               class="form-control cell-input bg-light text-muted"
                               value="900000"
                               readonly
                               aria-readonly="true"
                               aria-label="Default WO Qty" />
                    </td>
                    <td>
                        <input name="Package" form="createAwacsLfForm" class="form-control cell-input" maxlength="64" placeholder="SOT669" data-lfsize-package aria-label="Package" />
                    </td>
                    <td>
                        <input name="Device" form="createAwacsLfForm" class="form-control cell-input" maxlength="120" placeholder="BUK9Y59-60E" aria-label="Device" />
                    </td>
                    <td><span class="cell-muted">Current user</span></td>
                    <td><span class="cell-muted">Set on save</span></td>
                    <td class="text-center">
                        <button type="submit" form="createAwacsLfForm" class="icon-btn icon-save" title="Save new leadframe" aria-label="Save new AWACSLF row">
                            <span></span>
                        </button>
                    </td>
                    <td class="text-center">
                        <button type="button" class="icon-btn icon-cancel" id="cancelAddRow" title="Cancel add row" aria-label="Cancel add row">
                            <span></span>
                        </button>
                    </td>
                </tr>
            }

            @if (Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="11" class="text-center text-muted py-4">No AWACSLF rows found.</td>
                </tr>
            }
            else
            {
                var rowNumber = ((Model.Page - 1) * Model.PageSize) + 1;
                foreach (var row in Model.Rows)
                {
                    <tr class="excel-display-row" data-row-id="@row.TblRowId">
                        <td><input class="form-check-input" type="checkbox" aria-label="Select @row.Lf12Nc" /></td>
                        <td>@rowNumber</td>
                        <td class="fw-semibold">@row.Lf12Nc</td>
                        <td>@row.LfSize</td>
                        <td>@row.DefaultWoQty</td>
                        <td>@row.Package</td>
                        <td>@row.Device</td>
                        <td title="@row.LastUpdatedBy">@(await Directory.GetDisplayNameAsync(row.LastUpdatedBy))</td>
                        <td>@row.LastUpdate?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-center">
                            @if (canUpdate)
                            {
                                <button type="button" class="icon-btn icon-edit" data-edit-row="@row.TblRowId" title="Edit leadframe" aria-label="Edit @row.Lf12Nc">
                                    <span></span>
                                </button>
                            }
                        </td>
                        <td class="text-center">
                            @if (canDelete)
                            {
                                <button type="button" class="icon-btn icon-delete" data-delete-form="deleteAwacsLfForm-@row.TblRowId" data-delete-label="@row.Lf12Nc" title="Move leadframe to Trash" aria-label="Delete @row.Lf12Nc">
                                    <span></span>
                                </button>
                            }
                        </td>
                    </tr>

                    @if (canUpdate)
                    {
                        var editFormId = $"editAwacsLfForm-{row.TblRowId}";
                        <tr class="excel-edit-row d-none" data-edit-panel="@row.TblRowId">
                            <td><input class="form-check-input" type="checkbox" aria-label="Editing @row.Lf12Nc" disabled /></td>
                            <td><span class="cell-muted">@rowNumber</span></td>
                            <td>
                                <input name="Lf12Nc" form="@editFormId" class="form-control cell-input" maxlength="16" value="@row.Lf12Nc" data-original-value="@row.Lf12Nc" required aria-label="LF 12NC" />
                            </td>
                            <td>
                                <input name="LfSize" form="@editFormId" class="form-control cell-input" maxlength="16" value="@row.LfSize" data-original-value="@row.LfSize" list="lfSizeOptions"
                                       pattern="\d{1,4}\s*,\s*\d{1,4}" title="Two numbers separated by a comma, for example 20,5" required aria-label="LFSIZE" />
                            </td>
                            <td>
                                <input name="DefaultWoQty" form="@editFormId" type="number" step="1" min="0" class="form-control cell-input" value="@row.DefaultWoQty" data-original-value="@row.DefaultWoQty" aria-label="Default WO Qty" />
                            </td>
                            <td>
                                <input name="Package" form="@editFormId" class="form-control cell-input" maxlength="64" value="@row.Package" data-original-value="@row.Package" aria-label="Package" />
                            </td>
                            <td>
                                <input name="Device" form="@editFormId" class="form-control cell-input" maxlength="120" value="@row.Device" data-original-value="@row.Device" aria-label="Device" />
                            </td>
                            <td><span class="cell-muted">Save user</span></td>
                            <td><span class="cell-muted">Set on save</span></td>
                            <td class="text-center">
                                <button type="submit" form="@editFormId" class="icon-btn icon-save" title="Save edit" aria-label="Save @row.Lf12Nc">
                                    <span></span>
                                </button>
                            </td>
                            <td class="text-center">
                                <button type="button" class="icon-btn icon-cancel" data-cancel-edit="@row.TblRowId" title="Cancel edit" aria-label="Cancel edit @row.Lf12Nc">
                                    <span></span>
                                </button>
                            </td>
                        </tr>
                    }

                    rowNumber += 1;
                }
            }
        </tbody>
    </table>
</div>

@* Row forms live outside the table - see the note in Views/Awacs/RecipeGrid.cshtml. *@
<div class="row-forms d-none" aria-hidden="true">
    @if (canAdd)
    {
        <form id="createAwacsLfForm" asp-controller="AwacsLf" asp-action="Create" method="post">
            <input type="hidden" name="Confirmed" value="true" />
        </form>
    }

    @foreach (var row in Model.Rows)
    {
        if (canUpdate)
        {
            <form id="editAwacsLfForm-@row.TblRowId" asp-controller="AwacsLf" asp-action="Edit" method="post">
                <input type="hidden" name="TblRowId" value="@row.TblRowId" />
                <input type="hidden" name="Confirmed" value="true" />
            </form>
        }

        if (canDelete)
        {
            <form id="deleteAwacsLfForm-@row.TblRowId" asp-controller="AwacsLf" asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@row.TblRowId" />
                <input type="hidden" name="confirmed" value="true" />
            </form>
        }
    }
</div>

@{
    var startPage = Math.Max(1, Model.Page - 2);
    var endPage = Math.Min(Model.TotalPages, startPage + 4);
    startPage = Math.Max(1, endPage - 4);
}

<div class="pagination-bar">
    <span>Showing page @Model.Page of @Model.TotalPages, @Model.TotalRows total rows</span>
    <nav aria-label="AWACSLF pages">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="AwacsLf" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection">Prev</a>
            </li>
            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                    <a class="page-link" asp-controller="AwacsLf" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@pageNumber" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection">@pageNumber</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="AwacsLf" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection">Next</a>
            </li>
        </ul>
    </nav>
</div>

<div class="modal fade" id="awacsLfTemplateModal" tabindex="-1" aria-labelledby="awacsLfTemplateTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modern-modal template-modal">
            <div class="modal-header">
                <div>
                    <span class="eyebrow">CSV Template</span>
                    <h5 class="modal-title" id="awacsLfTemplateTitle">AWACSLF upload format</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ol class="template-steps">
                    <li>Download the template below.</li>
                    <li>Key in the values under the same headers - or delete the header row and key in the values only, in the same left-to-right order.</li>
                    <li>Keep LFSIZE inside quotes - <code>"20,5"</code> - so Excel does not split it into two columns.</li>
                    <li>In Excel, use Save As and choose CSV (Comma delimited) (*.csv).</li>
                </ol>

                <div class="template-preview-wrap">
                    <table class="table template-preview-table align-middle">
                        <thead>
                            <tr>
                                <th>LF12NC</th>
                                <th>LFSIZE</th>
                                <th>DEFAULTWOQTY</th>
                                <th>PACKAGE</th>
                                <th>DEVICE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (package, lfSize) in LeadframeSizes.Known)
                            {
                                <tr>
                                    <td>934661404115</td>
                                    <td>@lfSize</td>
                                    <td>900000</td>
                                    <td>@package</td>
                                    <td>BUK9Y59-60E</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="template-note">
                    Required columns: LF12NC, LFSIZE. LFSIZE must be two numbers separated by a comma.
                    The header row itself is optional: a file that starts straight at the values is read
                    in the column order above. Format LF12NC as Text in Excel, otherwise it is saved as
                    9.3E+11 and the upload is rejected.
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-primary" asp-controller="AwacsLf" asp-action="DownloadTemplate"><partial name="_Icon" model="@("download")" /> Download CSV Template</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><partial name="_Icon" model="@("close")" /> Close</button>
            </div>
        </div>
    </div>
</div>

@if (canDelete)
{
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modern-modal delete-confirm-modal">
                <div class="modal-header">
                    <div>
                        <span class="eyebrow">Delete Validation</span>
                        <h5 class="modal-title" id="deleteConfirmTitle">Move leadframe to Trash</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">This moves <strong id="deleteTargetName"></strong> to Trash, where it can be restored.</p>
                    <label for="deletePhrase" class="form-label">Type DELETE to continue</label>
                    <input id="deletePhrase" class="form-control" autocomplete="off" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><partial name="_Icon" model="@("cancel")" /> Cancel</button>
                    <button type="button" class="btn btn-nxp-orange" id="confirmDeleteButton" disabled><partial name="_Icon" model="@("delete")" /> Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/excel-grid.js" asp-append-version="true"></script>
    <script src="~/js/lfsize-combo.js" asp-append-version="true"></script>
    <script>
        window.excelGrid.init({
            tableId: 'awacsLfTable',
            storageKey: 'awacslf',
            csvInputId: 'awacsLfCsvFile',
            templateModalId: 'awacsLfTemplateModal'
        });

        // On the new row only: typing a known package offers its LFSIZE, until the
        // user types an LFSIZE of their own.
        (() => {
            const knownSizes = @Html.Raw(knownLfSizesJson);
            const packageInput = document.querySelector('[data-lfsize-package]');
            const lfSizeInput = document.querySelector('[data-lfsize]');
            if (!packageInput || !lfSizeInput) {
                return;
            }

            let lfSizeTouched = false;
            lfSizeInput.addEventListener('input', () => (lfSizeTouched = true));
            packageInput.addEventListener('input', () => {
                if (lfSizeTouched) {
                    return;
                }

                const suggestion = knownSizes[packageInput.value.trim().toUpperCase()];
                if (suggestion) {
                    lfSizeInput.value = suggestion;
                }
            });
        })();
    </script>
}

@functions {
    private static readonly (string Key, string Label)[] SortableColumns = new (string Key, string Label)[]
    {
        ("sequence", "#"),
        ("lf12nc", "LF12NC"),
        ("lfsize", "LFSIZE"),
        ("defaultwoqty", "DEFAULTWOQTY"),
        ("package", "PACKAGE"),
        ("device", "DEVICE"),
        ("lastupdatedby", "Last Updated By"),
        ("lastupdate", "Timestamp")
    };

    private static string NextSortDirection(AwacsLfViewModel model, string column)
    {
        return string.Equals(model.SortBy, column, StringComparison.OrdinalIgnoreCase)
            && string.Equals(model.SortDirection, "asc", StringComparison.OrdinalIgnoreCase)
                ? "desc"
                : "asc";
    }

    private static string SortClass(AwacsLfViewModel model, string column)
    {
        if (!string.Equals(model.SortBy, column, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        return string.Equals(model.SortDirection, "asc", StringComparison.OrdinalIgnoreCase)
            ? "is-active is-asc"
            : "is-active is-desc";
    }
}
