<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="work\**\*.cs" />
    <Content Remove="work\**\*" />
    <EmbeddedResource Remove="work\**\*" />
    <None Remove="work\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied to the output folder so the init-db command can read the script at run time. -->
    <Content Include="Database\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.0" />
  </ItemGroup>

</Project>
