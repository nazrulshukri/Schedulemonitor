+
+/* ---------------------------------------------------------------------
+   Keep a wide grid inside its own panel
+
+   .app-shell is a grid with minmax(0, 1fr) for the content track, so the
+   TRACK cannot blow out - but .app-main is a grid ITEM, and a grid item's
+   min-width is auto, meaning "at least as wide as my content". A table
+   wider than the track therefore stretched .app-main past it and the whole
+   page scrolled sideways: the topbar and the Delete column both ended up
+   cut off at the right edge.
+
+   min-width: 0 lets .app-main be narrower than its content again, so the
+   overflow lands where it belongs - inside .excel-panel, which is already
+   overflow-x: auto and scrolls on its own.
+   --------------------------------------------------------------------- */
+.app-main {
+    min-width: 0;
+}
+
+.data-panel.table-responsive.excel-panel {
+    max-width: 100%;
+}
