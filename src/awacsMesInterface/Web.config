<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="EWFM.AwacsMes.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <!-- MUST stay in step with the <oracle.manageddataaccess.client> section at the
         bottom of this file: declared but unused is fine, used but undeclared is
         HTTP 500.19 "missing a section declaration" and the whole site refuses to
         start. Version= must match bin\Oracle.ManagedDataAccess.dll - 19.18.0 in
         packages.config is assembly 4.122.19.1. -->
    <section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.19.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
  </configSections>
  <connectionStrings>
    <!--    <add name="MES" connectionString="Data Source=MESTEST_APMUXST1;Persist Security Info=True;User ID=pss_prod;Password=pss_prod;Unicode=True" providerName="System.Data.OracleClient"/>
 -->
	  <add name="OCAP"
     connectionString="Data Source=(DESCRIPTION=
        (ADDRESS=(PROTOCOL=TCP)(HOST=atcbfaq-scan.ph-cub01.nexperia.com)(PORT=1521))
        (CONNECT_DATA=(SERVICE_NAME=QAAPPS))
     );User ID=ocapsys;Password=ocap1234;Persist Security Info=True;"
     providerName="System.Data.OracleClient" />
    <!--<add name="MES" connectionString="Data Source=GA.WORLD;Persist Security Info=True;User ID=ga_prod;Password=ga_prod;Unicode=True" providerName="System.Data.OracleClient" />
    <add name="POWER" connectionString="Data Source=POWER.WORLD;Persist Security Info=True;User ID=power_reports;Password=power_reports;Unicode=True" providerName="System.Data.OracleClient" />
    <add name="OCAP" connectionString="Data Source=QAAPPS.WORLD;Persist Security Info=True;User ID=ocapsys;Password=ocap1234;Unicode=True" providerName="System.Data.OracleClient" />-->
    <!--<add name="RECIPE" connectionString="Data Source=MYGSERMYS1NB540;Initial Catalog=awacs;Integrated Security=False; Persist Security Info=True;User ID=sa;Password=NXPnxp123;" providerName="System.Data.SqlClient" />-->
    <!--<add name="RECIPE" connectionString="Data Source=165.114.94.19;Initial Catalog=awacs;Integrated Security=False; Persist Security Info=True;User ID=sa;Password=bef165!1a;" providerName="System.Data.SqlClient"/>-->
    <!--<add name="RECIPE" connectionString="Data Source=TIMEPD.WORLD;Persist Security Info=True;User ID=timepd_read;Password=timepd_read;Unicode=True" providerName="System.Data.OracleClient"/>-->
    <!-- 
    <add name="RECIPE" connectionString="Data Source=awacs;Persist Security Info=True;User ID=***;Password=***;Unicode=True" providerName="System.Data.OracleClient" />
        -->
  </connectionStrings>
  <appSettings>
    <add key="traceLogEnabled" value="true" />
    <add key="traceLogName" value="Awacs Mes Service" />
    <add key="traceLogMachine" value="." />
    <add key="traceLogWriteToFile" value="false" />
    <add key="traceLogLevel" value="Information" />
    <add key="dataProviderService" value="http://xxx/Minsc.WebService.DataProvider/Service.asmx" />
    <add key="dataProviderTimeout" value="10" />
    <!-- Sign-in page (Login.aspx). loginDomain is the Windows domain the typed
         credentials are validated against; leave it empty and sign in reports
         itself unavailable rather than letting anyone through. loginGroup is
         optional - set it to require membership of one group on top of a valid
         account, clear it to accept any domain account. -->
    <add key="loginDomain" value="" />
    <add key="loginGroup" value="" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <!-- 
            Set compilation debug="true" to insert debugging 
            symbols into the compiled page. Because this 
            affects performance, set this value to true only 
            during development.
        -->
    <compilation debug="true" targetFramework="4.5" />
    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 

            Forms, not Windows, because the ATCB assembly recipe pages ask for a
            user ID and password on Login.aspx instead of taking whoever is signed
            in to the PC - a shop floor browser is shared.

            This switch alone locks nothing down: ASP.NET still allows anonymous
            everywhere until a <location> below denies it. Service.asmx is
            explicitly kept anonymous (see its <location> at the end of this file)
            because the workstations call it machine to machine and have no cookie
            to send. Add pages to the protected <location> as they are built.
        -->
    <authentication mode="Forms">
      <!-- defaultUrl is Login.aspx only because there is no landing page in this
           project yet. Signing in with no ReturnUrl therefore comes back here, and
           Login.aspx answers that by showing who is signed in rather than looping.
           Point defaultUrl at the recipe landing page as soon as it exists. -->
      <forms name=".ATCBRECIPE"
             loginUrl="Login.aspx"
             defaultUrl="Login.aspx"
             protection="All"
             timeout="60"
             slidingExpiration="true"
             cookieless="UseCookies"
             requireSSL="false" />
    </authentication>
    <!--
            The <customErrors> section enables configuration 
            of what to do if/when an unhandled error occurs 
            during the execution of a request. Specifically, 
            it enables developers to configure html error pages 
            to be displayed in place of a error stack trace.
        -->
    <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
      <error statusCode="403" redirect="NoAccess.htm" />
      <error statusCode="404" redirect="FileNotFound.htm" />
    </customErrors>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" />
  </system.web>
  <!-- 
        The system.webServer section is required for running ASP.NET AJAX under Internet
        Information Services 7.0.  It is not necessary for previous version of IIS.
    -->
  <system.serviceModel>
    <bindings />
    <client />
  </system.serviceModel>
  <system.webServer>
    <!-- There is no home page in this application - it is one .asmx web service.
         Without this, browsing to the site root (http://host:port/) reaches
         IIS's directory lister, which is off, and answers

           HTTP Error 403.14 - Forbidden
           The Web server is configured to not list the contents of this directory

         which reads like a permissions problem and is not one. Naming
         Service.asmx as the default document makes the root serve the service
         help page, the same one you get from /Service.asmx.

         If your IIS locks this section down, the request comes back as 500.19
         "This configuration section cannot be used at this path". In that case
         delete this block and just browse to /Service.asmx directly. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Service.asmx" />
      </files>
    </defaultDocument>
  </system.webServer>
  <applicationSettings>
    <EWFM.AwacsMes.Properties.Settings>
      <setting name="AwacsMesService_phgcubadm1vwat1_Ad_HocTxn" serializeAs="String">
        <value>http://phgcubadm1vwat1/Minsc.WebService.AI/Ad-HocTxn.asmx</value>
      </setting>
      <setting name="AwacsMesService_phcab01vww01_Ad_HocTxn" serializeAs="String">
        <value>http://phcab01vww03/Minsc.WebService.AI/Ad-HocTxn.asmx</value>
      </setting>
    </EWFM.AwacsMes.Properties.Settings>
  </applicationSettings>
  <system.data>
    <DbProviderFactories>
      <remove invariant="Oracle.ManagedDataAccess.Client" />
      <add name="ODP.NET, Managed Driver" invariant="Oracle.ManagedDataAccess.Client" description="Oracle Data Provider for .NET, Managed Driver" type="Oracle.ManagedDataAccess.Client.OracleClientFactory, Oracle.ManagedDataAccess, Version=4.122.19.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
    </DbProviderFactories>
  </system.data>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <publisherPolicy apply="no" />
        <assemblyIdentity name="Oracle.ManagedDataAccess" publicKeyToken="89b483f429c47342" culture="neutral" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <oracle.manageddataaccess.client>
    <version number="*">
      <dataSources>
        <dataSource alias="SampleDataSource" descriptor="(DESCRIPTION=(ADDRESS=(PROTOCOL=tcp)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCL))) " />
      </dataSources>
    </version>
  </oracle.manageddataaccess.client>
  <!-- Service.asmx stays anonymous. The diebond workstations post to it with no
       user and no cookie jar; a forms authentication redirect would reach them as
       an HTML sign-in page where a SOAP response is expected, and every workorder
       update would fail. Deny anonymous on the pages, never on the service. -->
  <location path="Service.asmx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Login.aspx has to be reachable while signed out, or the redirect to it
       redirects to itself. -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- The pages that need a signed-in user go in a folder guarded like this.
       Uncomment once that folder exists - a <location> naming a path that is not
       there is ignored, but it is one more thing to read past.
  <location path="Recipe">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>
  -->
</configuration>
